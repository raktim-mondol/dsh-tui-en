# Normalize to LF in the repo and on checkout. tsc copies newlines from
# source template strings into lib/ artifacts (shipped in the npm package;
# prompt fragments are sent to the model). On Windows, core.autocrlf CRLF
# would leak into those artifacts (observed: channel.ts <bash-stdout>
# wrappers and reconciler warnings pick up \r). Pinning LF makes lib/
# byte-identical across contributor platforms.
* text=auto eol=lf

# Windows batch files are parsed by cmd.exe; keep CRLF on checkout
# (LF-only batch has historical parse quirks on label jumps and for-loops).
# Still normalize to LF in the repo.
*.cmd text eol=crlf

# Binary assets
*.png binary
