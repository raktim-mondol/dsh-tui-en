flowchart TB
  %% dsh-cc-tui master architecture diagram: all information is embedded in the nodes; line numbers are relative to audit baseline b2f4087

  subgraph CFG["Config layer"]
    C1["cordis.yml: 24 service ids, a bare dsh --config composition example; the cc-tui section's provider is half-pinned (no model key, cordis.yml:15)"]
    C2["cordis.patch.yml: 29 top-level overrides + 1 insert block (cordis.patch.yml:170, :178, :185, :214; publishIntervalMs=500 (:217))"]
    C3["dsh Loader composition: patch whole-row override semantics; the final composed content is unverified (node_modules isn't installed)"]
    C4["Session-backend reality: JSONL is mounted (cordis.patch.yml:143-149, cordis.yml:158-164); the SQLite claim is found only in older docs = documentation conflict/unconfirmed"]
  end

  subgraph ENTRY["Entry point and lifecycle"]
    E1["src/index.ts: the cc-tui plugin contract, inject declarations, the Config schema; a lightweight entry point that lazy-loads the runtime"]
    E2["src/plugin.ts: TTY check, the 5-tier language-chain resolution, assembling skills and the stderr guard, agent create/resume, React mount, unified exit cleanup; src/plugin.ts:26-33 self-describes as the front door"]
    E3["src/bootstrap/state.ts: a telemetry no-op stub, taking no part in the startup flow"]
  end

  subgraph CH["Session and channel"]
    H1["src/channel.ts: the session event log is the source of truth (src/channel.ts:110-114); every transcript row is derived from session/event, never a local React array"]
    H2["Action surface: submit / steer / resume / rewind / model / preset (src/channel.ts:34-58 ToolRow associated by callId)"]
    H3["Streaming pipeline: assistant/chunk frames aligned to emitStream's 16ms trailing edge (src/channel.ts:1114-1125); foldRows MAX_ROWS=600"]
    H4["TPS folding chain: src/channel.ts:2747-2760, src/channel.ts:2557-2566, src/channel.ts:2568-2595, src/channel.ts:2632-2652, src/channel.ts:2762-2782, sample cap 500"]
    H5["teardown exit funnel: context teardown must never reach process exit (issue 12, scripts/verify-teardown-exit.tsx mounted in CI .github/workflows/ci.yml:41)"]
  end

  subgraph APP["App-layer UI"]
    A1["src/screens/Chat.tsx: modal priority, global keys, scroll/search/selection state, slash dispatch; subscribes via useSyncExternalStore to channel.version (src/screens/Chat.tsx:118) and isSticky (src/screens/Chat.tsx:193-198)"]
    A2["src/screens/StatusLine.tsx: the status bar; model rendering src/screens/StatusLine.tsx:92-94, TPS readout (src/screens/StatusLine.tsx:57-87); src/screens/StatusMetrics.ts derives the metrics"]
    A3["src/components/MessageList.tsx: virtualization MAX_RENDERED_ROWS=300 (src/components/MessageList.tsx:28-30), a 5000-entry FIFO height cache (src/components/MessageList.tsx:114-134), MemoRow shallow comparison (src/components/MessageList.tsx:320-328), compactPreview truncateToWidth (src/components/MessageList.tsx:565-571)"]
    A4["src/components/WorkingSpinner.tsx, StreamingMarkdown.tsx, LoadedContextPanel.tsx, etc.; the runtime-context group (src/components/LoadedContextPanel.tsx:82-88)"]
    A5["src/components/design-system: theme-aware primitives (Box/Text/Select/PromptInput, etc.), IME avoidance"]
    A6["src/ui.ts: the themed renderer facade (Box/Text/render/selection/scrolling)"]
  end

  subgraph INK["The ported Ink render kernel (src/ink/, 103 files)"]
    I1["src/ink/ink.tsx: the Ink.render entry point (src/ink/ink.tsx:1464-1476, ConcurrentRoot:262); scheduleRender's 16ms throttle (src/ink/ink.tsx:212-216); the onRender main pipeline (src/ink/ink.tsx:420-794); the repaint trio (src/ink/ink.tsx:812-861); search-side rendering via scanElementSubtree (src/ink/ink.tsx:1083-1123)"]
    I2["src/ink/reconciler.ts: resetAfterCommit (src/ink/reconciler.ts:276-344, onRender:333); reading CLAUDE_CODE_DEBUG_REPAINTS/COMMIT_LOG (src/ink/reconciler.ts:192/202)"]
    I3["src/ink/log-update.ts: diff generation (src/ink/log-update.ts:173-558); DECSTBM hardware scrolling (src/ink/log-update.ts:228-251); in-place repaint of a shrink frame (src/ink/log-update.ts:285-337); skipping above viewportY (src/ink/log-update.ts:369-376/src/ink/log-update.ts:445-447); fullResetSequence_CAUSES_FLICKER (src/ink/log-update.ts:594-604)"]
    I4["src/ink/output.ts: an Operation queue + CharCache; flushBuffer precomputes per style run (src/ink/output.ts:703-737, grapheme segmentation:729); writeLineToScreen's hot loop (src/ink/output.ts:750-914)"]
    I5["src/ink/screen.ts: a packed typed-array, 2x Int32 per cell + a noSelect bitmap + damage regions; the CellWidth enum (src/ink/screen.ts:356-367); diff/diffEach (src/ink/screen.ts:1283-1367)"]
    I6["src/ink/dom.ts: the Yoga bridge; the incremental MeasureWrapCache (src/ink/dom.ts:445-549); measureTextNode (src/ink/dom.ts:447-549)"]
    I7["src/ink/optimizer.ts: merging cursorMove (src/ink/optimizer.ts:44-52) / collapsing cursorTo (:54-58) / hyperlink dedup (:70-77) / canceling matched pairs (:79-87)"]
    I8["src/ink/termio/osc.ts: OSC constants (src/ink/termio/osc.ts:249-269); osc ST/BEL (:23-26); wrapForMultiplexer (:43-52); setClipboard's three paths (:154-174); tabStatus's ant gating (:498-500/:510-527)"]
    I9["src/ink/terminal.ts: BSU/ESU 2026 synchronized output (BSU assembly :268, ESU :313); the SYNC_OUTPUT_SUPPORTED capability constant (:204) allowlist (:76-124); working around the win32 cursor-yank bug (:195-197)"]
    I10["src/ink/styles.ts: the Style type's 16 ansi names + Color union (src/ink/styles.ts:22-41)"]
  end

  subgraph TEX["Text measurement and CJK"]
    T1["src/ink/stringWidth.ts: the Bun branch (:211-231); the JS fallback correcting U+26A0 (:13-19); a three-tier path (:20-104); Devanagari ligature divergence (:205-209)"]
    T2["src/ink/line-width-cache.ts: cached per line, a 4096-entry/100k-character budget, detachString breaking off a SlicedString"]
    T3["src/ink/wrap-text.ts: wrap/wrap-trim/truncate dispatch (:47-81); truncate's three positions (:15-38); sliceFit's wide-character retry (:8-13)"]
    T4["src/ink/truncateToWidth.ts: the shared truncation helper, splitting by code point without cutting a wide character in half (:8-18); 3 call sites: FileSuggestions:38-49, CommandSuggestions:26-58, MessageList:565-571"]
    T5["src/native-ts/yoga-layout/: a pure-TS yoga port (src/native-ts/yoga-layout/index.ts:1-39); a generation + 4-slot LRU cache (src/native-ts/yoga-layout/index.ts:1387-1508)"]
  end

  subgraph INP["Input chain"]
    P1["src/ink/hooks/use-input.ts: useLayoutEffect synchronizes raw mode (:45-93)"]
    P2["src/ink/parse-keypress.ts: the tokenizer + regex table (:23-65); the keyName table (:316-418), keycodeToName's PUA key names (:503-557); DECRPM/DA1/DA2/XTVERSION parsing (:84-170)"]
    P3["src/ink/events/input-event.ts: parseKey produces the Key flags (:31-194)"]
    P4["src/ink/events/dispatcher.ts: the two-phase capture/bubble (:46-79); getEventPriority (:122-138)"]
    P5["src/ink/focus.ts: FocusManager's Tab cycle (:105-179), focusStack MAX 32"]
    P6["src/ink/hooks/use-terminal-size.ts: commented ported from the leak (:7)"]
  end

  subgraph THM["Theme and i18n"]
    M1["src/theme.ts: THEME_NAMES's three palettes (:92); 69 string keys; dark-ansi verbatim from the leak (:261-269); an unknown name falls back to dark (:346-355); the active-theme mirror (:381-398)"]
    M2["src/components/design-system/ThemeProvider.tsx: the forced-to-probed chain (:80-91); the OSC 11 probe's 400ms/luma 140 (:113-125); child components render only once the theme settles (:10-27); hot /theme switching (:133-144)"]
    M3["src/customTheme.ts: ~/.dsh-cc/themes/name.json; base + colors layering (:249-256); isSafeThemeName guarding against traversal (:90-103); resolveCustomTheme's cache (:258-289)"]
    M4["src/i18n.ts: 215 keys (:30-279); the 5-tier language chain (:5-11/:372-382); setLang hot-switching (:305-308); persistence (:336-365)"]
  end

  subgraph SYS["System features"]
    S1["The update system, src/update.ts: a 4s startup version check, 3-tier registry resolution, /update only in dsh --profile mode (pnpm update --latest); a confirmed defect: src/update.ts:232 reads the version after the fact, so DSH_CC_UPDATED_FROM=the new version, which necessarily misreports every successful update"]
    S2["MCP stderr aggregation: StdioClientTransport's stderr switched from inherit to a pipe, deduplicated and aggregated into a controlled notification (issue 17, scripts/verify-child-stderr.tsx mounted in CI .github/workflows/ci.yml:63); cross-spawn's behavior is only stated in a comment"]
    S3["Model routing, src/modelRoute.ts: config-priority > pref > default resolved atomically as a whole pair (issue 67, scripts/verify-model-route.mjs mounted in CI .github/workflows/ci.yml:67); /model switches immediately via fork and persists; the provider is pinned to the cc-tui section; the status bar follows the session's own record after a resume (issue 67)"]
    S4["Context, src/utils/loaded-context.ts: a conflict in how injected context is displayed (a separate panel group vs. older docs claiming it isn't listed); /doctor's storage-path check looks at ~/.dsh-cc/sessions, which doesn't match the JSONL root"]
    S5["Local commands, src/commands.ts: 39 built in (counted programmatically) + parsing helpers; /rewind and /new take effect in one go (pr-55)"]
    S6["Bundled skills, skills/*/SKILL.md: registered by src/packaged-skills.ts and shipped with the npm package"]
  end

  subgraph ORG["Provenance audit (a metadata reference block)"]
    O1["282 entries: unverified 116, project-self 81, cc-port 57, port-ink 18, generated 5, port-pi 3, port-yoga 2, deepseek-official 0 (counted programmatically)"]
    O1 -.breakdown.-> O2
    O2["Composition of the 57 cc-port markers: an explicit header comment 37, compiler-runtime 12, CLAUDE_CODE_* 5, ported CC build 2, a Slack link 1; markdown.ts's capitalized Ported is filed under the other category"]
    O3["Source distribution: src/ has 209 files in total (ink 103, components 53, utils 14, cc 8, screens 3, native-ts 2, bootstrap 1, hooks 1, types 1, 23 at the root); scripts/ has repro 10, verify 18; the npm package has 6 exports (package.json:9-25)"]
  end

