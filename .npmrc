# Leave auto-install-peers at the pnpm default (true) — that is what
# pnpm-lock.yaml settings records. Writing false makes pnpm 10 refuse
# install under --frozen-lockfile with ERR_PNPM_LOCKFILE_CONFIG_MISMATCH
# (CI's pnpm 11 does not check this; it only shows up locally). The
# lockfile is authoritative; keep config aligned.
legacy-peer-deps=true
